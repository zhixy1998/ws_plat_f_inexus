<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.persee.workstation.uv_inexus.dao.guide.userManageDao.UserConfigDAO">
    <update id="updateToken">
        update t_sysconfig_user set token = #{token} where user_name = #{user_name}
    </update>
    <select id="getPassword" resultType="String">
        select password from t_sysconfig_user where user_name = #{user_name}
    </select>
    <select id="getToken" resultType="java.lang.String">
        select token from t_sysconfig_user where user_name = #{user_name}
    </select>

</mapper>