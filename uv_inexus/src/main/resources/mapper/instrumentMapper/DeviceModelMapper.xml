<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.persee.workstation.uv_inexus.dao.guide.instrumentDao.DeviceModelInfoDAO">


    <select id="getDevTypeByDevModel" resultType="java.lang.String">
        select dev_type
        from t_device_init_entry a inner join t_device_type_info b on a.dev_type_id = b.id
        where a.dev_model = #{devModel}
    </select>
</mapper>