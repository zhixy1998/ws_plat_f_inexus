<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.persee.workstation.uv_inexus.dao.guide.instrumentDao.DeviceInfoDAO">


    <select id="getIp" resultType="java.lang.String">
        select device_ip as ip
        from t_ins_info_temp
        where device_serial_number = #{device_serial_number}
    </select>
</mapper>