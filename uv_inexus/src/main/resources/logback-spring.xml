<configuration>
    <!-- 控制台输出的日志 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 加密审计日志文件输出配置 -->
    <appender name="ENCRYPTED_AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/encrypted_audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>./logs/encrypted_audit.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>1825</maxHistory>
            <totalSizeCap>7GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!-- 加密审计专用 logger 配置 -->
    <logger name="ENCRYPTED_AUDIT_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="ENCRYPTED_AUDIT_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- 确保 Spring AOP 和切面相关的日志级别 -->
    <logger name="org.springframework.web.filter.CommonsRequestLoggingFilter" level="DEBUG"/>
    <logger name="org.springframework.aop" level="DEBUG"/>
    <logger name="org.aspectj" level="DEBUG"/>

    <!-- 根日志配置-->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>