<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

<!-- 项目基本信息配置 -->
    <groupId>org.example</groupId>  <!-- 组织ID，通常为组织或公司的唯一标识 -->
    <artifactId>testone</artifactId>  <!-- 项目ID，项目的唯一标识 -->
    <version>1.0-SNAPSHOT</version>  <!-- 项目版本号，SNAPSHOT表示开发中的版本 -->

<!-- 项目属性配置 -->
    <properties>
        <maven.compiler.source>8</maven.compiler.source>  <!-- 指定Java源代码版本为1.8 -->
        <maven.compiler.target>8</maven.compiler.target>  <!-- 指定Java编译目标版本为1.8 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>  <!-- 项目构建源文件编码为UTF-8 -->
        <spring-boot.version>2.6.13</spring-boot.version>  <!-- Spring Boot版本号，用于依赖管理 -->
    </properties>

<!-- 项目依赖配置 -->
    <dependencies>
    <!-- MyBatis Plus依赖，用于简化MyBatis开发 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>3.5.6</version>
        </dependency>

    <!-- Spring Boot WebSocket依赖，用于实现WebSocket功能 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

    <!-- Lombok依赖，用于简化Java代码编写 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
        </dependency>

    <!-- MySQL连接器依赖，用于连接MySQL数据库 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>  <!-- 运行时依赖 -->
            <version>8.0.31</version>
        </dependency>

    <!-- Spring Boot测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>  <!-- 测试范围依赖 -->
        </dependency>

    <!-- 动态数据源依赖，用于实现多数据源切换 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>dynamic-datasource-spring-boot-starter</artifactId>
            <version>3.3.2</version>
        </dependency>
    </dependencies>

<!-- 依赖管理配置 -->
    <dependencyManagement>
        <dependencies>
        <!-- Spring Boot依赖管理，用于统一管理Spring Boot相关依赖版本 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>  <!-- 表示这是一个POM类型的依赖 -->
                <scope>import</scope>  <!-- 表示导入依赖，而不是继承 -->
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>